FROM python:3.12-slim

# Bootstrap image: carries the Redivis client used to download the exams'
# series and the public label tables on a cache miss, plus numpy for array
# validation. The agent's image never installs redivis.
RUN pip install --no-cache-dir redivis==0.20.7 numpy==2.4.2
ENV PYTHONDONTWRITEBYTECODE=1
