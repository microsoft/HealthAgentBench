FROM python:3.12-slim

# Bootstrap image: downloads the EHRSHOT bundle on cache miss and runs the
# per-task slicer (stage_data.py) once per trial, then exits. It is the ONLY
# image that carries ``redivis`` -- that package transitively pulls in
# scikit-learn, scipy, polars, pyarrow and geopandas, none of which belong
# in the agent's image (Dockerfile). Harbor's ``down --rmi all`` removes this
# image with the rest of the per-trial compose project.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl util-linux unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    numpy==2.1.3 \
    pandas==2.2.3 \
    redivis==0.20.7

ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
RUN mkdir -p /workspace/data
