website/.astro/
website/node_modules/
.agent/
# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Experiment artifacts
results/

# temporary files
.tmp/

# Per-task gold is derived in-container at run time from the downloaded report
# (see scripts/ct_abnormality/gold_derivation.py) and written here by the
# bootstrap. It is never committed — the answer key / report text stay out of git.
tasks/ct_abnormality_*/tests/gold.json
tasks/ehr_event_modelling_*/tests/test_labels.csv
# MIMIC-CXR verifier-only artifacts written by the per-task bootstrap
# service from credentialed PhysioNet downloads. Never commit —
# PhysioNet redistribution rules apply.
tasks/xray_report_correction_*/tests/target_report.txt
# mri_qa: gold is derived in the bootstrap container at run time from the
# Redivis label tables and written here; never committed (MRNet access terms).
tasks/mri_qa_set_*/tests/gold.json
tasks/mri_qa_set_*/tests/data_verification.json
# local convenience helpers
resume-codex.sh
# project-level env file (schema documented in README.md; never commit secrets)
.env
.env.local
.env.*.local

# Raw public demo cache used only by compositional-QA bootstrap
assets/ehr_compositional_qa/

# Raw data caches populated by the per-task bootstrap services (CT-RATE, GDC
# slides, MIMIC-CXR, MIMIC-IV demo, EHRSHOT, MRNet). Never commit — licences
# and size. Only the scripts beside them (e.g. assets/mri_qa/*.py) are tracked.
assets/*/assets/
assets/ehr_event_modelling

# Harbor run outputs (trial logs, trajectories, artifacts). The job yamls in
# jobs/*.yaml are tracked; the per-run directories are not.
jobs/*/

# Local research scratch (probes, legacy task sets, audits); not part of the benchmark
research/

# Full-benchmark sweep outputs (Harbor run dirs); the job yamls beside them are tracked
full_run_v2/*/
