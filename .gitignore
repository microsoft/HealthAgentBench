.agent/
# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Experiment artifacts
results/

# temporary files
.tmp/

# Downloaded benchmark data and generated artifacts
# These are produced by setup.sh and generators, not source code
scripts/ehrsql/assets/
scripts/mimic_report_gen/assets/
scripts/tumor_area_selection_pathology/assets/cache/
# mimic_iv_dq build artifacts. Only ``task_configs.yaml`` (the deterministic
# benchmark seed) is committed; everything else under ``assets/`` is a
# regenerable cache (PhysioNet downloads, sliced configs, regenerated labels).
scripts/mimic_iv_dq/assets/*
!scripts/mimic_iv_dq/assets/task_configs.yaml
# clinical_trial_matching build artifacts. Only ``task_configs.yaml`` is committed;
# everything else under ``assets/`` is regenerable cache (topics2021.xml,
# qrels2021.txt, derived per-topic NCT lists).
scripts/clinical_trial_matching/assets/*
!scripts/clinical_trial_matching/assets/task_configs.yaml
# ct_abnormality build artifacts. Only ``manifest.yaml`` is committed; everything
# else under ``assets/`` is regenerable cache (downloaded NIfTI volumes from
# Hugging Face, ~1 GB total).
scripts/ct_abnormality/assets/*
!scripts/ct_abnormality/assets/manifest.yaml
# local convenience helpers
resume-codex.sh
