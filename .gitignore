.agent/
# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Experiment artifacts
results/

# temporary files
.tmp/

# Downloaded benchmark data and generated artifacts
# These are produced by setup.sh and generators, not source code
scripts/ehrsql/assets/
scripts/xray_report_gen/assets/
scripts/tumor_area_selection_pathology/assets/cache/
# ehr_data_quality build artifacts. Only ``task_configs.yaml`` (the deterministic
# benchmark seed) is committed; everything else under ``assets/`` is a
# regenerable cache (PhysioNet downloads, sliced configs, regenerated labels).
scripts/ehr_data_quality/assets/*
!scripts/ehr_data_quality/assets/task_configs.yaml
# clinical_trial_matching build artifacts. Only ``task_configs.yaml`` is committed;
# everything else under ``assets/`` is regenerable cache (topics2021.xml,
# qrels2021.txt, derived per-topic NCT lists).
scripts/clinical_trial_matching/assets/*
!scripts/clinical_trial_matching/assets/task_configs.yaml
# ct_abnormality build artifacts. Only ``manifest.yaml`` is committed; everything
# else under ``assets/`` is regenerable cache (downloaded NIfTI volumes from
# Hugging Face, ~1 GB total).
scripts/ct_abnormality/assets/*
!scripts/ct_abnormality/assets/manifest.yaml
# ehrshot build artifacts. Only ``task_configs.yaml`` is committed; the bulk
# EHRSHOT bundle is staged on the host (NOT under scripts/ehrshot/assets/) at
# ``$EHRSHOT_ASSETS_DIR``. If the user does choose to put it under
# ``assets/raw_cache/``, it stays gitignored.
scripts/ehrshot/assets/*
!scripts/ehrshot/assets/task_configs.yaml
# test_labels.csv is derived from the bundle by the bootstrap container at
# run time and written into tasks/ehrshot/<task>/tests/ via a host
# bind-mount. It contains the held-out labels; never commit it.
tasks/ehrshot/*/tests/test_labels.csv
# MIMIC-CXR verifier-only artifacts written by the per-task bootstrap
# service from credentialed PhysioNet downloads. Never commit —
# PhysioNet redistribution rules apply.
tasks/xray_report_gen/*/tests/task_answer_key.json
tasks/xray_report_gen/*/tests/target_report.txt
# local convenience helpers
resume-codex.sh
# project-level env file (schema documented in README.md; never commit secrets)
.env
.env.local
.env.*.local
